# Copy to .env in this folder and fill in from the Supabase dashboard
# (Project Settings -> API). Restart `npm run dev` after changing.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Express API (only needed if not running on the default localhost:5050)
# VITE_API_URL=http://localhost:5050
